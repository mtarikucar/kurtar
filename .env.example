DATABASE_URL=postgresql://kurtar:kurtar@localhost:4754/kurtar
REDIS_URL=redis://localhost:4755
KURTAR_API_PORT=4750
NODE_ENV=development

# JWT — required at boot in every environment (JwtStrategy refuses to
# start without JWT_SECRET). Access tokens are short-lived; refresh tokens
# are opaque (not JWTs) and only their SHA-256 hash is persisted, so no
# separate refresh secret is needed.
JWT_SECRET=change-me-32-chars-minimum-please
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# SMS provider — selects which modules/sms provider SmsService uses.
# "mock" (the default) logs the message instead of sending it and is
# REFUSED at boot when NODE_ENV=production. Set to "netgsm" or "twilio"
# with the matching credentials below for real delivery.
SMS_PROVIDER=mock

# NetGSM (recommended for Turkey)
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=

# Twilio (international)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Payment provider (Task 4) — selects which modules/payments-core provider
# the reservations/payments seam uses. "mock" (the default) is an
# in-memory fake used for dev/test and is REFUSED at boot when
# NODE_ENV=production (config/env.validation.ts). "iyzico"/"paytr" are
# reserved enum values accepted by validation with no adapter implemented
# yet — setting either boots fine, but PaymentProviderRegistry.get() 404s
# the first time anything actually dispatches to it, since nothing
# registers for that id.
PAYMENT_PROVIDER=mock

# Shared-secret header the mock payment provider requires on every inbound
# POST /api/webhooks/payment call (its stand-in for real HMAC signature
# verification). Required unconditionally in every environment (mock
# provider's own constructor throws without it) and additionally enforced
# at boot in production alongside DATABASE_URL/REDIS_URL
# (config/env.validation.ts) — mirrors JWT_SECRET.
WEBHOOK_SECRET=change-me-dev-webhook-secret

# Push provider (Task 7) — selects which modules/notifications/push
# provider PushFacadeService uses. "mock" (the default) records sends
# in-memory for dev/test and is REFUSED at boot when NODE_ENV=production
# (config/env.validation.ts), mirroring PAYMENT_PROVIDER exactly. "expo"
# sends real pushes via https://exp.host — EXPO_ACCESS_TOKEN is optional
# (only needed for Expo's enhanced-security mode).
PUSH_PROVIDER=mock
EXPO_ACCESS_TOKEN=

# Email (Task 7) — EmailService (modules/notifications/email). Optional in
# development/test/staging: when EMAIL_HOST/EMAIL_USER/EMAIL_PASSWORD are
# unset, emails are logged instead of sent. REFUSED at boot when
# NODE_ENV=production (a log-only mail transport is not allowed there) —
# mirrors SMS_PROVIDER/PAYMENT_PROVIDER/PUSH_PROVIDER's mock-in-production
# refusal.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
APP_NAME=Kurtar

# Merchant web dashboard base URL — the CTA link in merchant lifecycle
# emails (merchant-approved.hbs etc). Optional; MerchantStatusEmailHandler
# falls back to a placeholder if unset.
MERCHANT_DASHBOARD_URL=https://merchant.kurtar.app
