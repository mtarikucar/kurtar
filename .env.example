DATABASE_URL=postgresql://kurtar:kurtar@localhost:4754/kurtar
REDIS_URL=redis://localhost:4755
KURTAR_API_PORT=4750
NODE_ENV=development

# JWT — required at boot in every environment (JwtStrategy refuses to
# start without JWT_SECRET). Access tokens are short-lived; refresh tokens
# are opaque (not JWTs) and only their SHA-256 hash is persisted, so no
# separate refresh secret is needed.
JWT_SECRET=change-me-32-chars-minimum-please
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# SMS provider — selects which modules/sms provider SmsService uses.
# "mock" (the default) logs the message instead of sending it and is
# REFUSED at boot when NODE_ENV=production. Set to "netgsm" or "twilio"
# with the matching credentials below for real delivery.
SMS_PROVIDER=mock

# NetGSM (recommended for Turkey)
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=

# Twilio (international)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
