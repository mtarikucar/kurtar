DATABASE_URL=postgresql://kurtar:kurtar@localhost:4754/kurtar

# The database the real-DB test suites run against. WITHOUT IT, 33 of the
# backend's 121 suites — the money paths, the settlement arithmetic, the
# oversell races — call `describe.skip` and the run reports green having
# verified none of them. A silent skip is not a pass.
#
# Point it at a THROWAWAY database, never at the one above: those suites
# write, and one of them deletes the demo data on purpose.
#   createdb -h localhost -p 4754 -U kurtar kurtar_test
#   npx prisma migrate deploy   # with DATABASE_URL set to that database
TEST_DATABASE_URL=postgresql://kurtar:kurtar@localhost:4754/kurtar_test
REDIS_URL=redis://localhost:4755
KURTAR_API_PORT=4750
NODE_ENV=development

# CORS (Task 9.5) — comma-separated list of browser origins allowed to
# call this API with credentials (cookies), e.g.
# "https://merchant.kurtar.app,https://admin.kurtar.app". Optional ONLY
# on a local machine: config/cors-origins.ts falls back to the four
# frontend dev servers' fixed origins (apps/merchant-web:5173,
# apps/admin-web:5174, landing:3000, apps/consumer web preview:8081 — see
# docs/frontend-contract.md) when this is unset and NODE_ENV is
# "development" or "test". In every DEPLOYED environment — staging as
# much as production — an unset CORS_ALLOWED_ORIGINS means NO CORS is
# enabled at all (same as before Task 9.5), so it must be set explicitly
# before any web panel can call the API cross-origin from a browser.
CORS_ALLOWED_ORIGINS=

# Refresh-cookie hardening. The refresh cookie is always httpOnly,
# SameSite=strict and scoped to its actor's own path; `Secure` is on
# unconditionally when NODE_ENV=production, and set to "true" here for
# any OTHER deployed environment that is served over TLS (e.g. staging
# behind a proxy). Leave unset on plain HTTP: a Secure cookie over HTTP
# is never sent back by the browser, which breaks sign-in outright.
REFRESH_COOKIE_SECURE=

# JWT — required at boot in every environment (JwtStrategy refuses to
# start without JWT_SECRET). Access tokens are short-lived; refresh tokens
# are opaque (not JWTs) and only their SHA-256 hash is persisted, so no
# separate refresh secret is needed.
JWT_SECRET=change-me-32-chars-minimum-please
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# SMS provider — selects which modules/sms provider SmsService uses.
# "mock" (the default) logs the message instead of sending it and is
# REFUSED at boot when NODE_ENV=production. Set to "netgsm" or "twilio"
# with the matching credentials below for real delivery.
SMS_PROVIDER=mock

# NetGSM (recommended for Turkey)
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=

# Twilio (international)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Payment provider (Task 4) — selects which modules/payments-core provider
# the reservations/payments seam uses. "mock" (the default) is an
# in-memory fake used for dev/test and is REFUSED at boot when
# NODE_ENV=production (config/env.validation.ts). "iyzico"/"paytr" are
# reserved enum values accepted by validation with no adapter implemented
# yet — setting either boots fine, but PaymentProviderRegistry.get() 404s
# the first time anything actually dispatches to it, since nothing
# registers for that id.
PAYMENT_PROVIDER=mock

# Shared-secret header the mock payment provider requires on every inbound
# POST /api/webhooks/payment call (its stand-in for real HMAC signature
# verification). Required unconditionally in every environment (mock
# provider's own constructor throws without it) and additionally enforced
# at boot in production alongside DATABASE_URL/REDIS_URL
# (config/env.validation.ts) — mirrors JWT_SECRET.
WEBHOOK_SECRET=change-me-dev-webhook-secret

# Push provider (Task 7) — selects which modules/notifications/push
# provider PushFacadeService uses. "mock" (the default) records sends
# in-memory for dev/test and is REFUSED at boot when NODE_ENV=production
# (config/env.validation.ts), mirroring PAYMENT_PROVIDER exactly. "expo"
# sends real pushes via https://exp.host — EXPO_ACCESS_TOKEN is optional
# (only needed for Expo's enhanced-security mode).
PUSH_PROVIDER=mock
EXPO_ACCESS_TOKEN=

# Email (Task 7) — EmailService (modules/notifications/email). Optional in
# development/test/staging: when EMAIL_HOST/EMAIL_USER/EMAIL_PASSWORD are
# unset, emails are logged instead of sent. REFUSED at boot when
# NODE_ENV=production (a log-only mail transport is not allowed there) —
# mirrors SMS_PROVIDER/PAYMENT_PROVIDER/PUSH_PROVIDER's mock-in-production
# refusal.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
APP_NAME=Kurtar

# Merchant web dashboard base URL — the CTA link in merchant lifecycle
# emails (merchant-approved.hbs etc). Optional; MerchantStatusEmailHandler
# falls back to a placeholder if unset.
MERCHANT_DASHBOARD_URL=https://merchant.kurtar.app

# Platform commission-invoice constants (Task 8) — the default fixed bag
# fee (₺25, before %20 KDV) and annual membership fee (₺1.990), used to
# seed platform_pricing's initial row via the migration; not read directly
# by the app at runtime (PricingService always reads the table). Kept here
# only as operator-facing documentation of the values that migration seeds.
# PLATFORM_BAG_FEE_CENTS=2500
# MEMBERSHIP_ANNUAL_CENTS=199000

# E-document provider (Task 8) — selects which modules/invoicing provider
# CommissionInvoiceService uses to issue a batch's commission invoice.
# "mock" (the default) records issuance in-memory for dev/test. "nilvera"
# is INERT until BOTH NILVERA_API_KEY and NILVERA_API_URL are set —
# without them NilveraAdapter simply never registers, so selecting
# "nilvera" without credentials 404s the first time anything is issued
# rather than attempting a real request with undefined auth. Unlike
# PAYMENT_PROVIDER/PUSH_PROVIDER, "mock" is NOT refused at boot in
# production for this one — Nilvera e-invoicing is not yet certified for
# go-live (see invoicing/adapters/nilvera.adapter.ts).
EDOC_PROVIDER=mock
NILVERA_API_KEY=
NILVERA_API_URL=

# Trust & safety (Task 9) — where complaint-sla-cron.service.ts /
# moderation-takedown-cron.service.ts send their "approaching/breached
# deadline" digest emails. Optional: if unset, both crons still enforce
# the SLA (escalate on breach, stamp warning sentinels) and log at
# `error`, they just skip the email step — "never silently pass a
# deadline" holds either way, this only controls whether ops ALSO gets
# paged by email.
OPS_ALERT_EMAIL=

# Impact ledger CO2e constant (Task 9) — grams of CO2e saved per redeemed
# bag, written by impact/impact-redeemed.handler.ts. Optional; defaults to
# 2500 (TGTG's own published ~2.5kg/bag figure — see
# impact/impact.constants.ts) when unset.
CO2E_PER_BAG_GRAMS=2500
