{
  "expo": {
    "name": "kurtar",
    "slug": "kurtar-consumer",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kurtar",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.kurtar.consumer",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Yakınındaki mağazaları ve fırsatları gösterebilmemiz için konumunu kullanıyoruz.",
        "UIBackgroundModes": []
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.kurtar.consumer",
      "adaptiveIcon": {
        "backgroundColor": "#F2542D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "${EXPO_PUBLIC_ANDROID_MAPS_API_KEY}"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yakınındaki mağazaları ve fırsatları gösterebilmemiz için konumunu kullanıyoruz."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#F2542D"
        }
      ],
      "expo-font"
    ]
  }
}
