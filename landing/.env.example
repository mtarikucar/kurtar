# Origin of the kurtar API — the client appends /api/... itself, do not
# include a trailing /api here. NEXT_PUBLIC_ vars are inlined into the
# client bundle at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4750

# Canonical origin of THIS site — used to build absolute URLs in
# metadata, sitemap.xml, robots.txt, and JSON-LD. Must be set to the real
# production domain in every real deploy; falls back to the domain
# reserved in docs/plans/2026-08-12-kurtar-master-plan.md §5.5 so a local
# build never crashes for lack of it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where /isletme's CTAs send a merchant to sign up — apps/merchant-web's
# dev origin by default (docs/frontend-contract.md's port table). The
# path MUST be /kayit — apps/merchant-web/src/routes.ts's real signup
# route (every route in that app is Turkish; /signup matches nothing and
# falls through to the login screen). Point the origin at merchant-web's
# real production domain once it ships; keep the /kayit path.
NEXT_PUBLIC_MERCHANT_APP_URL=http://localhost:5173/kayit
