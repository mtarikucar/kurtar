model Rating {
  id String @id @default(cuid())

  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)

  overallStars Int
  foodQuality  Int?
  service      Int?
  comment      String?

  // [Task 9] Visibility policy (documented here, enforced in
  // modules/ratings/ratings.service.ts's create()): a rating with NO
  // comment is auto-APPROVED immediately (nothing to moderate, and the
  // vast majority of ratings are a bare star tap — gating those on an
  // admin would silently stall every store's average). A rating WITH a
  // comment starts PENDING and needs an explicit admin approve/reject
  // (modules/ratings' admin queue) before it counts toward
  // Store.avgStars/ratingCount or appears in any public listing. REJECTED
  // is terminal (used both by the admin ratings queue and by a
  // content-report "action" on a RATING target — modules/moderation).
  moderationStatus ModerationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, moderationStatus])
  @@map("ratings")
}

model Favorite {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, storeId])
  @@index([storeId])
  @@map("favorites")
}

model ImpactLedger {
  id String @id @default(cuid())

  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: SetNull)

  mealsSaved      Int
  co2eGrams       Int
  moneySavedCents Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("impact_ledgers")
}

