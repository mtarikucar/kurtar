// TRUST & SAFETY
// ========================================

model ComplaintTicket {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  category    ComplaintCategory
  description String
  status      ComplaintStatus @default(OPEN)

  // [Task 9] ETAHS wording is calendar days, not business days (unlike
  // settlements' 5-BUSINESS-day due date) — set at creation as
  // now + 15 calendar days (modules/complaints/sla-date-math.ts).
  slaDeadlineAt DateTime
  resolvedAt    DateTime?
  // [Task 9] Stamped the first time complaint-sla-cron.service.ts sends
  // the "approaching deadline" admin alert for this ticket — the same
  // sentinel-column idempotency pattern pickupReminderSentAt/
  // shortfallResolvedAt already use elsewhere, so an hourly sweep never
  // re-alerts on the same ticket. NULL means "not yet warned". Breach
  // itself needs no separate sentinel — the OPEN/MERCHANT_RESPONDED ->
  // ESCALATED transition is naturally idempotent (a guarded UPDATE whose
  // WHERE no longer matches once ESCALATED).
  slaWarningSentAt DateTime?
  // [I3 fix] The single-fire guard for ComplaintsService.adminRefund — a
  // REDEEMED reservation has no further status transition to piggyback
  // an idempotency guarantee on (unlike cancel()'s CONFIRMED ->
  // CANCELLED_BY_USER), so this ticket's own refundedAt is the guarded
  // compare-and-swap (NULL -> now) instead, the same sentinel-column
  // pattern as slaWarningSentAt/pickupReminderSentAt above. NULL means
  // "no refund triggered from this ticket yet"; cleared back to NULL if
  // the provider call itself fails, so a retry through the same ticket
  // stays possible.
  refundedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ComplaintMessage[]

  @@index([status, slaDeadlineAt])
  @@map("complaint_tickets")
}

/// [Task 9] The message thread on a ComplaintTicket — consumer, the
/// complained-about merchant, and admin all post here (authorization is
/// modules/complaints/complaints.service.ts's job, not a DB constraint:
/// authorType/authorId are a soft reference, matching
/// MerchantVerificationEvent.actorAdminId's precedent, since a message's
/// author can be any of three separate principal tables). A MERCHANT
/// reply is also what flips ComplaintTicket.status OPEN -> MERCHANT_RESPONDED
/// (see complaints.service.ts's addMessage) — there is no separate "reply"
/// endpoint.
model ComplaintMessage {
  id String @id @default(cuid())

  complaintId String
  complaint   ComplaintTicket @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  authorType PrincipalType
  authorId   String
  body       String

  createdAt DateTime @default(now())

  @@index([complaintId, createdAt])
  @@map("complaint_messages")
}

model ContentReport {
  id String @id @default(cuid())

  targetType ReportTargetType
  targetId   String
  reason     String

  status             ReportStatus @default(OPEN)
  // [Task 9] now + 48h at creation (modules/moderation).
  takedownDeadlineAt DateTime
  resolvedAt         DateTime?
  // [Task 9] ReportStatus has no ESCALATED value (unlike ComplaintStatus)
  // — a breach here is alert-only, never an automatic status change, so
  // BOTH the approaching and the breached alert need their own sentinel
  // to stay idempotent across cron ticks (mirrors
  // ComplaintTicket.slaWarningSentAt).
  takedownWarningSentAt  DateTime?
  takedownBreachedSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, takedownDeadlineAt])
  @@map("content_reports")
}

// ========================================
// PLATFORM INFRA
// ========================================

/// Transactional outbox — same shape as kds's OutboxEvent
/// (backend/src/modules/outbox), minus the tenant/branch columns kurtar
/// has no equivalent of.
model OutboxEvent {
  // Generated at the application layer (cuid) so events sort roughly by
  // creation time without needing a sequence; safe across replicas.
  id String @id @default(cuid())

  // Versioned dotted name, e.g. "reservation.created.v1".
  type String

  // Full event body; consumers parse this against the event contract.
  payload Json

  // [Task 7] Producer-side dedup key, nullable + UNIQUE — a producer that
  // supplies one (e.g. "offer-published:<offerId>") gets a REAL guarantee
  // that a duplicate insert can never land twice; a producer with no
  // natural dedup key simply omits it, and Postgres treats each NULL as
  // distinct so any number of keyless rows may coexist. Was a bare
  // non-null String with NO constraint before this task — every producer
  // happened to set it, but nothing enforced uniqueness. A collision on
  // this column is a genuine P2002 that propagates out of
  // OutboxService.publish and aborts the caller's WHOLE transaction —
  // deliberately NOT caught/swallowed inside the transaction (an aborted
  // Postgres transaction answers every subsequent statement, including
  // COMMIT, without raising — see reservations.service.ts's
  // createReservationWithRetry doc comment for the identical footgun
  // fixed once already in this codebase). See
  // modules/outbox/outbox.service.ts.
  idempotencyKey String? @unique

  // [Task 7] Delayed dispatch: NULL means "eligible as soon as status/
  // nextAttemptAt allow it" (every event before this task); a future
  // instant defers OutboxWorkerService's claim query until it has passed —
  // e.g. the reservation.redeemed.v1 rating invite, queued at redeem time
  // but not meant to fire until 2 hours later.
  scheduledFor DateTime?

  // Drain state machine: queued -> processing -> done | dead (retried
  // rows return to queued with a future nextAttemptAt in between).
  status    String  @default("queued")
  attempts  Int     @default(0)
  lastError String?

  dispatchedAt  DateTime?
  nextAttemptAt DateTime?
  // [Task 7 fix round] Set on every claim (fresh OR stale-lease reclaim —
  // see outbox-worker.service.ts's claimBatch/OUTBOX_LEASE_MS). Doubles as
  // an optimistic-concurrency token: mark*() only succeeds if claimedAt
  // still matches what THIS claim set, so a worker that finishes late
  // (past its own lease, after someone else already reclaimed the row)
  // can never stomp on the reclaimer's work.
  claimedAt     DateTime?

  createdAt DateTime @default(now())

  // Worker scans `(status='queued' AND nextAttemptAt <= now()) OR
  // (status='processing' AND claimedAt <= now() - lease), AND
  // (scheduledFor IS NULL OR scheduledFor <= now())` in id order.
  @@index([status, nextAttemptAt])
  @@index([status, claimedAt])
  @@index([type, createdAt])
  @@map("outbox_events")
}

model AuditLog {
  id String @id @default(cuid())

  actorType String
  actorId   String?
  action    String
  entity    String
  entityId  String
  diffJson  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("audit_logs")
}

/// Turkish public holidays — drives the 5-business-day settlement calendar.
model PublicHoliday {
  id String @id @default(cuid())

  date DateTime @unique @db.Date
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("public_holidays")
}
